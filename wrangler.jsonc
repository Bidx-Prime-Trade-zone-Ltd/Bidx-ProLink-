{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bidx-prolink",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-08",
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "bix"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  }
}
